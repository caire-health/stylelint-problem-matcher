{
  "name": "stylelint-problem-matcher",
  "version": "1.0.0",
  "private": true,
  "description": "Sets up a problem matcher for stylelint that's used to create annotations for violations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "lint": "tsc --noEmit",
    "package": "ncc build src/main.ts",
    "release": "npm run package && git add -f dist/",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xt0rted/dotnet-format-linter-action.git"
  },
  "keywords": [
    "actions",
    "github",
    "problem-matcher",
    "annotations"
  ],
  "author": "xt0rted",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "//overrides": [
    "js-yaml >=3.15.2: CVE-2026-84375, GHSA-5p4m-2wfm-xmqj, CVE-2026-59869, CVE-2026-53550",
    "browserslist >=4.29.0: CVE-2026-73088",
    "brace-expansion >=1.1.16: CVE-2026-13149",
    "@babel/core >=7.29.1 <8: CVE-2026-49356 (capped at 7.x — babel-plugin-istanbul requires ^7)",
    "undici >=6.28.0: CVE-2026-22036, CVE-2026-1525, CVE-2026-1527, CVE-2026-9679, CVE-2026-16728, CVE-2026-16729, CVE-2026-15157"
  ],
  "overrides": {
    "js-yaml": ">=3.15.2",
    "browserslist": ">=4.29.0",
    "brace-expansion": ">=1.1.16",
    "@babel/core": ">=7.29.1 <8.0.0",
    "undici": ">=6.28.0"
  },
  "devDependencies": {
    "@types/jest": "^28.1.7",
    "@types/node": "^20.14.11",
    "@vercel/ncc": "^0.38.2",
    "cross-env": "^7.0.3",
    "github-actions-problem-matcher-typings": "^1.1.0",
    "jest": "^28.1.3",
    "jest-circus": "^29.7.0",
    "ts-jest": "^28.0.8",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  }
}
